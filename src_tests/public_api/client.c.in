#include <stdalign.h>
#include "uni_hal.h"
#include "io/uni_hal_io_tunnel.h"
#include "segger/uni_hal_segger_rtt.h"
#include "segger/uni_hal_segger_rtt_stdio.h"
#if defined(UNI_HAL_TARGET_MCU_STM32H743) || defined(UNI_HAL_TARGET_MCU_STM32L496)
#include "pwr/uni_hal_pwr_stm32.h"
#endif
#if defined(UNI_HAL_TARGET_MCU_STM32H753)
#include "stm32h7xx_hal.h"
#endif
#if defined(UNI_HAL_TARGET_MCU_STM32L496)
#include "pwr/uni_hal_pwr_stm32l4.h"
#endif

#if defined(UNI_HAL_TARGET_MCU_STM32L496) || defined(UNI_HAL_TARGET_MCU_ZYNQ7000)
// A function declaration with one of these names would conflict at compile time.
enum { uni_hal_spi_is_busy, uni_hal_spi_set_prescaler, uni_hal_spi_transceive_async };
#endif

#if configAPPLICATION_ALLOCATED_HEAP
alignas(portBYTE_ALIGNMENT) uint8_t ucHeap[configTOTAL_HEAP_SIZE];
#endif

// Volatile stores keep every reference live through optimization and linker GC.
// The consumer only takes addresses and can run without touching any peripherals.
typedef void (*api_function_t)(void);
static api_function_t volatile reference;
#define LINK_API(fn) reference = (api_function_t)(fn)

int main(void) {
@references@
#if defined(UNI_HAL_TARGET_MCU_STM32H753)
    LINK_API(HAL_CRYP_Encrypt_DMA);
    LINK_API(HAL_HASHEx_SHA256_Start_DMA);
#endif
    return reference == NULL;
}
