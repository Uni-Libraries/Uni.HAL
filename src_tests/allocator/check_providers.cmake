if(MCU MATCHES "^STM32")
    file(SIZE "${BIN_FILE}" image_size)
    if((MCU STREQUAL "STM32L496" AND image_size GREATER 1048576) OR
       (MCU MATCHES "^STM32H7" AND image_size GREATER 2097152))
        message(FATAL_ERROR "${BIN_FILE} (${image_size} bytes) exceeds the target flash")
    endif()
endif()

file(READ "${MAP_FILE}" map)
string(FIND "${map}" "Cross Reference Table" start)
if(start LESS 0)
    message(FATAL_ERROR "Missing linker cross-reference table in ${MAP_FILE}")
endif()
string(SUBSTRING "${map}" ${start} -1 table)

# The first object in each cross-reference entry is the symbol's definition.
function(check_provider symbol pattern)
    if(NOT table MATCHES "\n${symbol}[ \t]+[^\n]*${pattern}")
        message(FATAL_ERROR "Wrong or missing provider for ${symbol} in ${MAP_FILE} (expected ${pattern})")
    endif()
endfunction()

if(PICOLIBC)
    set(libc_provider [=[libc(_nano)?\.a\(]=])
else()
    # Arm GNU selects newlib's libg or libg_nano archive when linking with debug info.
    set(libc_provider [=[lib[cg](_nano)?\.a\(]=])
endif()
foreach(symbol malloc calloc realloc free memalign)
    check_provider("${symbol}" "${libc_provider}")
endforeach()
if(PICOLIBC)
    set(lock_symbols __wrap___retarget_lock_acquire_recursive __wrap___retarget_lock_release_recursive)
    check_provider(sbrk [=[freertos_libc_heap\.c\.]=])
else()
    foreach(symbol _malloc_r _calloc_r _realloc_r _free_r _memalign_r)
        check_provider("${symbol}" "${libc_provider}")
    endforeach()
    set(lock_symbols __malloc_lock __malloc_unlock)
    check_provider(_sbrk_r [=[freertos_libc_heap\.c\.]=])
    if(MCU STREQUAL "ZYNQ7000")
        check_provider(_sbrk [=[libxil[^/]*\.a\(]=])
    else()
        check_provider(_sbrk [=[freertos_libc_heap\.c\.]=])
    endif()
endif()
foreach(symbol IN LISTS lock_symbols)
    check_provider("${symbol}" [=[freertos_libc_lock\.c\.]=])
endforeach()
foreach(symbol pvPortMalloc vPortFree)
    check_provider("${symbol}" [=[libfreertos_kernel\.a\(heap_4\.c\.]=])
endforeach()
