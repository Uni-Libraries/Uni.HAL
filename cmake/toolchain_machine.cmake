# CMake rereads this toolchain in the projects it creates for compiler probes.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES UNI_HAL_TARGET_MCU)
if(UNI_HAL_TARGET_MCU STREQUAL "STM32H743")
    include("${CMAKE_CURRENT_LIST_DIR}/toolchain_machine_arm_cm7.cmake")
elseif(UNI_HAL_TARGET_MCU STREQUAL "STM32L496")
    include("${CMAKE_CURRENT_LIST_DIR}/toolchain_machine_arm_cm4f.cmake")
elseif(UNI_HAL_TARGET_MCU STREQUAL "ZYNQ7000")
    include("${CMAKE_CURRENT_LIST_DIR}/toolchain_machine_arm_ca9.cmake")
elseif(UNI_HAL_TARGET_MCU STREQUAL "PC")
    include("${CMAKE_CURRENT_LIST_DIR}/toolchain_machine_x86.cmake")
else()
    message(FATAL_ERROR "UNI_HAL_TARGET_MCU must be one of STM32H743, STM32L496, ZYNQ7000 or PC (got '${UNI_HAL_TARGET_MCU}')")
endif()
